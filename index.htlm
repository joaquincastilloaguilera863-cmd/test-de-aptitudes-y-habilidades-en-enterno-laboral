<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Evaluación de Aptitudes Administrativas</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
:root{--azul-oscuro:#0b2545;--azul:#155e9e;--azul-claro:#2b8ac6;--celeste:#eaf6ff;--fondo:#eef3f8;--blanco:#fff;--texto:#203040;--texto-suave:#647586;--borde:#d8e2ec;--verde:#16855b;--dorado:#f3b83f;--sombra:0 12px 38px rgba(11,37,69,.12)}
*{box-sizing:border-box}body{margin:0;font-family:Inter,Arial,sans-serif;background:var(--fondo);color:var(--texto)}
.container{width:min(1100px,calc(100% - 32px));margin:30px auto;background:#fff;border-radius:22px;overflow:hidden;box-shadow:var(--sombra)}
.header{position:relative;overflow:hidden;padding:38px 45px;color:#fff;background:linear-gradient(135deg,#0b2545 0%,#155e9e 62%,#2b8ac6 100%);border-bottom:5px solid var(--dorado)}
.header:before,.header:after{content:"";position:absolute;border-radius:50%;background:rgba(255,255,255,.07)}
.header:before{width:280px;height:280px;right:-80px;top:-130px}.header:after{width:180px;height:180px;right:180px;bottom:-120px}
.header-content{position:relative;z-index:2}.header h1{margin:0 0 10px;font-size:30px;font-weight:800;letter-spacing:-.5px}.header p{margin:0;max-width:760px;color:rgba(255,255,255,.88);font-size:15px;line-height:1.6}.header h1:before{content:'▦  ';color:#f3b83f}
.badge{display:inline-flex;padding:7px 13px;margin-bottom:18px;border-radius:30px;background:rgba(243,184,63,.16);border:1px solid rgba(243,184,63,.55);color:#fff;font-size:12px;font-weight:800;letter-spacing:.7px;text-transform:uppercase}
.content,#resultado{padding:35px 45px 45px}.instructions{background:var(--celeste);border:1px solid #d5eafa;border-radius:14px;padding:20px 22px;margin-bottom:28px}.instructions h3{margin:0 0 8px;font-size:16px;color:var(--azul-oscuro)}.instructions p{margin:0;font-size:14px;line-height:1.6;color:var(--texto-suave)}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:30px}.form-group label{display:block;margin-bottom:8px;font-size:13px;font-weight:700}.form-group input{width:100%;padding:13px 15px;border:1px solid var(--borde);border-radius:10px;outline:none;font-family:inherit;font-size:14px;background:#fbfdff}.form-group input:focus{border-color:var(--azul);box-shadow:0 0 0 3px rgba(23,105,170,.1);background:#fff}
.timer{position:sticky;top:15px;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:14px 18px;margin-bottom:25px;border-radius:13px;background:#102a43;color:#fff;box-shadow:0 8px 20px rgba(16,42,67,.18)}.timer-label{font-size:13px;font-weight:600;opacity:.85}#timer{font-size:21px;font-weight:800;letter-spacing:1px}
.question{position:relative;padding:24px;margin-bottom:18px;border:1px solid var(--borde);border-radius:15px;background:#fff;transition:.25s ease}.question:before{content:"";position:absolute;left:0;top:18px;bottom:18px;width:4px;border-radius:0 5px 5px 0;background:linear-gradient(180deg,var(--azul),var(--azul-claro))}.question:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(16,42,67,.07);border-color:#cbdbe9}.question-number{display:inline-block;margin-bottom:10px;color:var(--azul);font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.7px}.question h3{margin:0 0 18px;font-size:16px;line-height:1.55;font-weight:700}
.options{display:grid;gap:10px}.option{position:relative}.option input{position:absolute;opacity:0;pointer-events:none}.option label{display:block;padding:14px 16px;border:1px solid var(--borde);border-radius:10px;background:#fbfdff;cursor:pointer;font-size:14px;line-height:1.5;color:#425466;transition:.2s}.option label:hover{border-color:var(--azul-claro);background:#f5faff;transform:translateX(2px)}.option input:checked+label{border-color:var(--azul);background:var(--celeste);color:var(--azul-oscuro);font-weight:600;box-shadow:0 0 0 2px rgba(23,105,170,.08)}.option input:checked+label:after{content:"✓";float:right;color:var(--azul);font-size:17px;font-weight:800}
.button-container{display:flex;justify-content:center;margin-top:32px}button{border:0;border-radius:11px;padding:15px 30px;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer;color:#fff;background:linear-gradient(135deg,#1769aa,#2f80c0);box-shadow:0 8px 20px rgba(23,105,170,.22);transition:.2s}button:hover{transform:translateY(-2px);box-shadow:0 12px 25px rgba(23,105,170,.28)}
#resultado{display:none}.result-header{padding:25px;margin-bottom:25px;border-radius:15px;background:linear-gradient(135deg,#0b2545,#155e9e);color:#fff;border-left:5px solid var(--dorado)}.result-header h2{margin:0 0 8px;font-size:24px}.result-header p{margin:0;opacity:.85;font-size:14px}
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:28px}.metric{padding:20px;border:1px solid var(--borde);border-radius:13px;background:#fff;text-align:center}.metric-label{display:block;margin-bottom:8px;color:var(--texto-suave);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px}.metric-value{font-size:20px;font-weight:800;color:var(--azul-oscuro)}
.profile-title{margin:0 0 15px;font-size:18px;color:var(--azul-oscuro)}.profile-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:15px}.profile-card{padding:20px;border:1px solid var(--borde);border-radius:13px;background:#fbfdff}.profile-card h4{margin:0 0 10px;font-size:14px}.level{display:inline-block;padding:5px 9px;margin-bottom:9px;border-radius:20px;background:var(--celeste);color:var(--azul);font-size:11px;font-weight:800}.profile-card p{margin:0;color:var(--texto-suave);font-size:13px;line-height:1.55}
.conclusion{margin-top:25px;padding:22px;border-radius:13px;border-left:4px solid var(--verde);background:#f3faf7}.conclusion h3{margin:0 0 10px;color:#126846;font-size:16px}.conclusion p{margin:0;color:#466158;font-size:14px;line-height:1.65}.print-button{margin-top:25px;background:#fff;color:var(--azul);border:1px solid var(--azul);box-shadow:none}
@media(max-width:760px){.container{width:calc(100% - 18px);margin:10px auto;border-radius:15px}.header{padding:30px 24px}.header h1{font-size:24px}.content,#resultado{padding:25px 20px 30px}.form-grid,.profile-grid,.metrics{grid-template-columns:1fr}.question{padding:20px 17px}.timer{top:8px}}
@media print{body{background:#fff}.container{width:100%;margin:0;box-shadow:none;border-radius:0}.timer,button,.print-button{display:none!important}.header{print-color-adjust:exact;-webkit-print-color-adjust:exact}.question{break-inside:avoid}}

.tp-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:-4px 0 26px}
.tp-item{padding:13px 15px;border:1px solid var(--borde);border-radius:12px;background:#f8fbfe;text-align:center}
.tp-item strong{display:block;color:var(--azul-oscuro);font-size:12px;text-transform:uppercase;letter-spacing:.5px}
.tp-item span{display:block;margin-top:4px;color:var(--texto-suave);font-size:12px}
.section-title{display:flex;align-items:center;gap:10px;margin:0 0 16px;color:var(--azul-oscuro);font-size:17px}
.section-title:before{content:"";width:5px;height:22px;border-radius:4px;background:var(--dorado)}
.form-group select{width:100%;padding:13px 15px;border:1px solid var(--borde);border-radius:10px;outline:none;font-family:inherit;font-size:14px;background:#fbfdff;color:var(--texto);cursor:pointer}
.form-group select:focus{border-color:var(--azul);box-shadow:0 0 0 3px rgba(23,105,170,.1);background:#fff}
.office-card{margin-top:22px;padding:16px 18px;border-radius:12px;background:linear-gradient(90deg,#f4f9fd,#fff);border:1px solid #dce8f1;color:var(--texto-suave);font-size:12px;line-height:1.6}
.office-card strong{color:var(--azul-oscuro)}
@media(max-width:760px){.tp-strip{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="container">
<div class="header"><div class="header-content"><div class="badge">Evaluación de selección</div><h1>Evaluación de Aptitudes Administrativas</h1><p>Evaluación orientada a identificar capacidades de análisis, organización, resolución de problemas, atención al detalle, toma de decisiones y adaptación en situaciones administrativas.</p></div></div>
<div id="test" class="content">
<div class="instructions"><h3>📋 Instrucciones de evaluación</h3><p>Lee cuidadosamente cada situación y selecciona la alternativa que consideres más adecuada. No existen cálculos matemáticos. El objetivo es conocer tu forma de analizar y actuar frente a situaciones habituales de trabajo administrativo.</p></div>
<div class="tp-strip">
<div class="tp-item"><strong>Modalidad</strong><span>Evaluación presencial</span></div>
<div class="tp-item"><strong>Área</strong><span>Administración y servicios</span></div>
<div class="tp-item"><strong>Duración</strong><span>15 minutos</span></div>
</div>
<h2 class="section-title">Datos del postulante</h2>
<div class="form-grid">
<div class="form-group"><label for="nombre">Nombre completo</label><input type="text" id="nombre" placeholder="Ingresa tu nombre"></div>
<div class="form-group"><label for="cargo">Cargo al que postula</label>
<select id="cargo">
<option value="">Selecciona un cargo</option>
<option>Asistente Administrativo</option>
<option>Secretario/a Administrativo/a</option>
<option>Recepcionista</option>
<option>Ejecutivo/a de Atención al Cliente</option>
<option>Asistente de Recursos Humanos</option>
<option>Asistente Contable</option>
<option>Asistente de Logística</option>
<option>Otro cargo administrativo</option>
</select>
</div>
</div>
<div class="office-card"><strong>Perfil administrativo:</strong> esta evaluación considera competencias relacionadas con organización, atención al detalle, análisis, toma de decisiones, resolución de problemas y adaptación a situaciones de trabajo.</div>
<div class="timer"><span class="timer-label">Tiempo restante</span><span id="timer">15:00</span></div>

<div class="question"><span class="question-number">Pregunta 01</span><h3>Recibes un correo con información que contiene dos datos aparentemente contradictorios. ¿Qué haces primero?</h3><div class="options">
<div class="option"><input type="radio" name="q1" value="A" id="q1a"><label for="q1a">A) Respondo utilizando el dato que parece más lógico.</label></div>
<div class="option"><input type="radio" name="q1" value="B" id="q1b"><label for="q1b">B) Ignoro la diferencia y continúo con el trabajo.</label></div>
<div class="option"><input type="radio" name="q1" value="C" id="q1c"><label for="q1c">C) Verifico la información antes de entregar una respuesta.</label></div>
<div class="option"><input type="radio" name="q1" value="D" id="q1d"><label for="q1d">D) Reenvío el correo sin revisarlo.</label></div></div></div>

<div class="question"><span class="question-number">Pregunta 02</span><h3>Tienes cuatro tareas pendientes, todas diferentes en importancia y plazo. ¿Qué criterio utilizarías para organizarlas?</h3><div class="options">
<div class="option"><input type="radio" name="q2" value="A" id="q2a"><label for="q2a">A) Realizarlas en el orden en que llegaron.</label></div>
<div class="option"><input type="radio" name="q2" value="B" id="q2b"><label for="q2b">B) Comenzar por las tareas más fáciles.</label></div>
<div class="option"><input type="radio" name="q2" value="C" id="q2c"><label for="q2c">C) Considerar urgencia, plazo e impacto de cada tarea.</label></div>
<div class="option"><input type="radio" name="q2" value="D" id="q2d"><label for="q2d">D) Elegir una tarea al azar y continuar desde ahí.</label></div></div></div>

<div class="question"><span class="question-number">Pregunta 03</span><h3>Estás preparando un informe y detectas que una página contiene información diferente al resto del documento. ¿Qué haces?</h3><div class="options">
<div class="option"><input type="radio" name="q3" value="A" id="q3a"><label for="q3a">A) Elimino la página para evitar confusión.</label></div>
<div class="option"><input type="radio" name="q3" value="B" id="q3b"><label for="q3b">B) Reviso el origen de la diferencia antes de enviar el informe.</label></div>
<div class="option"><input type="radio" name="q3" value="C" id="q3c"><label for="q3c">C) Envío el informe porque probablemente no sea importante.</label></div>
<div class="option"><input type="radio" name="q3" value="D" id="q3d"><label for="q3d">D) Cambio el dato para que coincida con los demás.</label></div></div></div>

<div class="question"><span class="question-number">Pregunta 04</span><h3>Una tarea rutinaria deja de funcionar como normalmente lo hace y tu supervisor no está disponible. ¿Cuál sería tu primera reacción?</h3><div class="options">
<div class="option"><input type="radio" name="q4" value="A" id="q4a"><label for="q4a">A) Dejo la tarea pendiente hasta que regrese el supervisor.</label></div>
<div class="option"><input type="radio" name="q4" value="B" id="q4b"><label for="q4b">B) Busco información, reviso procedimientos y evalúo alternativas.</label></div>
<div class="option"><input type="radio" name="q4" value="C" id="q4c"><label for="q4c">C) Espero sin intentar resolverlo.</label></div>
<div class="option"><input type="radio" name="q4" value="D" id="q4d"><label for="q4d">D) Hago cualquier cambio para intentar solucionarlo.</label></div></div></div>

<div class="question"><span class="question-number">Pregunta 05</span><h3>La empresa implementa un nuevo sistema que no conoces. ¿Cuál sería tu forma de abordarlo?</h3><div class="options">
<div class="option"><input type="radio" name="q5" value="A" id="q5a"><label for="q5a">A) Evitar utilizarlo hasta que otra persona me enseñe.</label></div>
<div class="option"><input type="radio" name="q5" value="B" id="q5b"><label for="q5b">B) Utilizarlo inmediatamente sin revisar instrucciones.</label></div>
<div class="option"><input type="radio" name="q5" value="C" id="q5c"><label for="q5c">C) Aprender progresivamente y consultar cuando sea necesario.</label></div>
<div class="option"><input type="radio" name="q5" value="D" id="q5d"><label for="q5d">D) Continuar utilizando el sistema anterior indefinidamente.</label></div></div></div>

<div class="question"><span class="question-number">Pregunta 06</span><h3>Una instrucción indica que las solicitudes recibidas antes de las 16:00 se procesan el mismo día y las posteriores el siguiente día hábil. Recibes una solicitud a las 16:10. ¿Cuándo corresponde procesarla?</h3><div class="options">
<div class="option"><input type="radio" name="q6" value="A" id="q6a"><label for="q6a">A) El mismo día, porque llegó cerca de la hora límite.</label></div>
<div class="option"><input type="radio" name="q6" value="B" id="q6b"><label for="q6b">B) El siguiente día hábil.</label></div>
<div class="option"><input type="radio" name="q6" value="C" id="q6c"><label for="q6c">C) Cuando exista tiempo disponible.</label></div>
<div class="option"><input type="radio" name="q6" value="D" id="q6d"><label for="q6d">D) No procesarla.</label></div></div></div>

<div class="question"><span class="question-number">Pregunta 07</span><h3>Tienes dos posibles soluciones para un problema: una rápida y temporal y otra más lenta pero definitiva. ¿Cómo decides?</h3><div class="options">
<div class="option"><input type="radio" name="q7" value="A" id="q7a"><label for="q7a">A) Siempre elijo la más rápida.</label></div>
<div class="option"><input type="radio" name="q7" value="B" id="q7b"><label for="q7b">B) Siempre elijo la solución definitiva.</label></div>
<div class="option"><input type="radio" name="q7" value="C" id="q7c"><label for="q7c">C) Analizo consecuencias, urgencia, recursos y efectos a largo plazo.</label></div>
<div class="option"><input type="radio" name="q7" value="D" id="q7d"><label for="q7d">D) Dejo que otra persona decida.</label></div></div></div>

<div class="question"><span class="question-number">Pregunta 08</span><h3>Tienes 12 tareas pendientes. ¿Cuál es la mejor forma de comenzar?</h3><div class="options">
<div class="option"><input type="radio" name="q8" value="A" id="q8a"><label for="q8a">A) Comenzar por la más sencilla.</label></div>
<div class="option"><input type="radio" name="q8" value="B" id="q8b"><label for="q8b">B) Organizarlas según prioridad y plazo.</label></div>
<div class="option"><input type="radio" name="q8" value="C" id="q8c"><label for="q8c">C) Resolverlas en el orden que aparezcan.</label></div>
<div class="option"><input type="radio" name="q8" value="D" id="q8d"><label for="q8d">D) Elegir las que más me gusten.</label></div></div></div>

<div class="question"><span class="question-number">Pregunta 09</span><h3>Un compañero te solicita realizar una tarea que normalmente corresponde a otra área, pero no existe autorización clara. ¿Qué haces?</h3><div class="options">
<div class="option"><input type="radio" name="q9" value="A" id="q9a"><label for="q9a">A) La realizo inmediatamente para ayudar.</label></div>
<div class="option"><input type="radio" name="q9" value="B" id="q9b"><label for="q9b">B) La rechazo sin revisar nada.</label></div>
<div class="option"><input type="radio" name="q9" value="C" id="q9c"><label for="q9c">C) Verifico el procedimiento y la autorización correspondiente.</label></div>
<div class="option"><input type="radio" name="q9" value="D" id="q9d"><label for="q9d">D) La dejo pendiente sin informar.</label></div></div></div>

<div class="question"><span class="question-number">Pregunta 10</span><h3>Un cliente entrega información incompleta para realizar una gestión. ¿Cuál sería tu reacción?</h3><div class="options">
<div class="option"><input type="radio" name="q10" value="A" id="q10a"><label for="q10a">A) Completar la información por mi cuenta.</label></div>
<div class="option"><input type="radio" name="q10" value="B" id="q10b"><label for="q10b">B) Realizar igualmente la gestión.</label></div>
<div class="option"><input type="radio" name="q10" value="C" id="q10c"><label for="q10c">C) Identificar qué información falta y solicitarla.</label></div>
<div class="option"><input type="radio" name="q10" value="D" id="q10d"><label for="q10d">D) Ignorar la solicitud.</label></div></div></div>

<div class="question"><span class="question-number">Pregunta 11</span><h3>Detectas una pequeña diferencia en un documento extenso. ¿Qué haces?</h3><div class="options">
<div class="option"><input type="radio" name="q11" value="A" id="q11a"><label for="q11a">A) La ignoro porque parece poco importante.</label></div>
<div class="option"><input type="radio" name="q11" value="B" id="q11b"><label for="q11b">B) Reviso si la diferencia afecta al resto del documento.</label></div>
<div class="option"><input type="radio" name="q11" value="C" id="q11c"><label for="q11c">C) Elimino el dato diferente.</label></div>
<div class="option"><input type="radio" name="q11" value="D" id="q11d"><label for="q11d">D) Cambio el dato inmediatamente.</label></div></div></div>

<div class="question"><span class="question-number">Pregunta 12</span><h3>Realizas tareas repetitivas diariamente. ¿Cuál sería una buena forma de mejorar tu desempeño?</h3><div class="options">
<div class="option"><input type="radio" name="q12" value="A" id="q12a"><label for="q12a">A) Hacerlas cada día de una forma diferente.</label></div>
<div class="option"><input type="radio" name="q12" value="B" id="q12b"><label for="q12b">B) Identificar patrones y crear un método que reduzca errores y tiempo.</label></div>
<div class="option"><input type="radio" name="q12" value="C" id="q12c"><label for="q12c">C) Realizarlas lo más rápido posible sin revisar.</label></div>
<div class="option"><input type="radio" name="q12" value="D" id="q12d"><label for="q12d">D) Esperar que otra persona encuentre una mejor forma.</label></div></div></div>

<div class="question"><span class="question-number">Pregunta 13</span><h3>Detectas un problema que podría afectar el trabajo de un compañero. ¿Qué haces?</h3><div class="options">
<div class="option"><input type="radio" name="q13" value="A" id="q13a"><label for="q13a">A) Espero para comprobar si realmente ocurre.</label></div>
<div class="option"><input type="radio" name="q13" value="B" id="q13b"><label for="q13b">B) Lo informo oportunamente entregando información clara.</label></div>
<div class="option"><input type="radio" name="q13" value="C" id="q13c"><label for="q13c">C) No digo nada porque no es mi responsabilidad.</label></div>
<div class="option"><input type="radio" name="q13" value="D" id="q13d"><label for="q13d">D) Informo a varias personas sin verificar los antecedentes.</label></div></div></div>

<div class="question"><span class="question-number">Pregunta 14</span><h3>Tu supervisor cambia la prioridad de trabajo debido a una situación urgente. ¿Cómo reaccionas?</h3><div class="options">
<div class="option"><input type="radio" name="q14" value="A" id="q14a"><label for="q14a">A) Continúo exactamente con el plan anterior.</label></div>
<div class="option"><input type="radio" name="q14" value="B" id="q14b"><label for="q14b">B) Reorganizo mis tareas considerando la nueva prioridad.</label></div>
<div class="option"><input type="radio" name="q14" value="C" id="q14c"><label for="q14c">C) Dejo todas las tareas pendientes.</label></div>
<div class="option"><input type="radio" name="q14" value="D" id="q14d"><label for="q14d">D) Espero hasta que alguien me indique cada paso.</label></div></div></div>

<div class="question"><span class="question-number">Pregunta 15</span><h3>Te enfrentas a un problema que nunca habías visto antes. ¿Cuál sería tu forma de actuar?</h3><div class="options">
<div class="option"><input type="radio" name="q15" value="A" id="q15a"><label for="q15a">A) Esperar a que otra persona lo resuelva.</label></div>
<div class="option"><input type="radio" name="q15" value="B" id="q15b"><label for="q15b">B) Comprender el problema, revisar la información disponible y luego consultar si es necesario.</label></div>
<div class="option"><input type="radio" name="q15" value="C" id="q15c"><label for="q15c">C) Intentar cualquier solución rápidamente.</label></div>
<div class="option"><input type="radio" name="q15" value="D" id="q15d"><label for="q15d">D) Ignorar el problema.</label></div></div></div>

<div class="button-container"><button onclick="finalizarTest()">Finalizar evaluación</button></div>
</div>

<div id="resultado">
<div class="result-header"><h2>Resultado de la evaluación</h2><p>Perfil general de aptitudes administrativas</p></div>
<div class="metrics">
<div class="metric"><span class="metric-label">Candidato</span><span class="metric-value" id="resultNombre">-</span></div>
<div class="metric"><span class="metric-label">Cargo</span><span class="metric-value" id="resultCargo">-</span></div>
<div class="metric"><span class="metric-label">Precisión</span><span class="metric-value" id="resultPrecision">-</span></div>
<div class="metric"><span class="metric-label">Tiempo</span><span class="metric-value" id="resultTiempo">-</span></div>
</div>
<h3 class="profile-title">Perfil de competencias</h3>
<div class="profile-grid">
<div class="profile-card"><h4>Capacidad analítica</h4><span class="level" id="analisisNivel"></span><p id="analisisTexto"></p></div>
<div class="profile-card"><h4>Resolución de problemas</h4><span class="level" id="problemasNivel"></span><p id="problemasTexto"></p></div>
<div class="profile-card"><h4>Atención al detalle</h4><span class="level" id="detalleNivel"></span><p id="detalleTexto"></p></div>
<div class="profile-card"><h4>Organización y priorización</h4><span class="level" id="organizacionNivel"></span><p id="organizacionTexto"></p></div>
<div class="profile-card"><h4>Toma de decisiones</h4><span class="level" id="decisionNivel"></span><p id="decisionTexto"></p></div>
<div class="profile-card"><h4>Adaptabilidad</h4><span class="level" id="adaptabilidadNivel"></span><p id="adaptabilidadTexto"></p></div>
<div class="profile-card"><h4>Comprensión de instrucciones</h4><span class="level" id="comprensionNivel"></span><p id="comprensionTexto"></p></div>
</div>
<div class="conclusion"><h3>Conclusión del perfil</h3><p id="conclusion"></p></div>
<div class="button-container"><button class="print-button" onclick="window.print()">Imprimir resultado</button></div>
</div>
</div>

<script>
const respuestasCorrectas={q1:"C",q2:"C",q3:"B",q4:"B",q5:"C",q6:"B",q7:"C",q8:"B",q9:"C",q10:"C",q11:"B",q12:"B",q13:"B",q14:"B",q15:"B"};
const competencias={q1:["analisis","detalle"],q2:["organizacion","decision"],q3:["detalle","analisis"],q4:["problemas","adaptabilidad"],q5:["adaptabilidad"],q6:["comprension","detalle"],q7:["decision","analisis"],q8:["organizacion"],q9:["decision"],q10:["problemas","analisis"],q11:["detalle"],q12:["problemas","organizacion"],q13:["comprension","decision"],q14:["adaptabilidad","organizacion"],q15:["problemas","analisis"]};
let tiempoInicio=Date.now(),tiempoFinalizado=false,segundosRestantes=900;
const timerElement=document.getElementById("timer");
const intervalo=setInterval(()=>{if(tiempoFinalizado)return;segundosRestantes--;if(segundosRestantes<=0){segundosRestantes=0;actualizarTimer();clearInterval(intervalo);finalizarTest();return}actualizarTimer()},1000);
function actualizarTimer(){timerElement.textContent=String(Math.floor(segundosRestantes/60)).padStart(2,"0")+":"+String(segundosRestantes%60).padStart(2,"0")}
function obtenerNivel(p){return p>=75?"Alto":p>=50?"Adecuado":"Por desarrollar"}
function obtenerVelocidad(s){return s<=420?"Muy rápida":s<=600?"Rápida":s<=780?"Moderada":"Pausada"}
function textoCompetencia(n,c){const t={analisis:{Alto:"Demuestra capacidad para revisar información, identificar diferencias y analizar antecedentes antes de actuar.",Adecuado:"Presenta una capacidad analítica funcional para situaciones administrativas habituales.","Por desarrollar":"Puede requerir mayor desarrollo en revisión, interpretación y análisis de información."},problemas:{Alto:"Muestra iniciativa para comprender problemas, evaluar alternativas y buscar soluciones.",Adecuado:"Presenta una capacidad adecuada para abordar problemas habituales.","Por desarrollar":"Puede requerir mayor estructura al enfrentar situaciones nuevas o problemas complejos."},detalle:{Alto:"Presenta una marcada atención a inconsistencias y detalles relevantes.",Adecuado:"Mantiene un nivel adecuado de revisión y atención al detalle.","Por desarrollar":"Puede requerir mayor revisión antes de entregar información o resultados."},organizacion:{Alto:"Demuestra capacidad para ordenar tareas considerando prioridades, plazos e impacto.",Adecuado:"Presenta una organización funcional para administrar tareas y prioridades.","Por desarrollar":"Puede requerir mayor estructura para priorizar tareas y administrar múltiples pendientes."},decision:{Alto:"Analiza antecedentes y consecuencias antes de tomar decisiones.",Adecuado:"Toma decisiones razonables considerando la información disponible.","Por desarrollar":"Puede requerir mayor análisis antes de decidir frente a situaciones laborales."},adaptabilidad:{Alto:"Muestra capacidad para ajustarse a cambios y enfrentar situaciones nuevas.",Adecuado:"Presenta una adaptación adecuada frente a cambios habituales.","Por desarrollar":"Puede requerir mayor flexibilidad ante cambios o situaciones no previstas."},comprension:{Alto:"Demuestra capacidad para interpretar instrucciones y aplicarlas correctamente.",Adecuado:"Comprende y aplica instrucciones de manera generalmente adecuada.","Por desarrollar":"Puede requerir mayor atención al interpretar y aplicar instrucciones."}};return t[c][n]}
function finalizarTest(){if(tiempoFinalizado)return;tiempoFinalizado=true;clearInterval(intervalo);const nombre=document.getElementById("nombre").value.trim()||"Sin especificar",cargo=document.getElementById("cargo").value.trim()||"Sin especificar",tiempoUsado=Math.floor((Date.now()-tiempoInicio)/1000);let correctas=0;const puntajes={analisis:0,problemas:0,detalle:0,organizacion:0,decision:0,adaptabilidad:0,comprension:0},totales={analisis:0,problemas:0,detalle:0,organizacion:0,decision:0,adaptabilidad:0,comprension:0};
Object.keys(respuestasCorrectas).forEach(q=>{const s=document.querySelector(`input[name="${q}"]:checked`),cs=competencias[q];cs.forEach(c=>totales[c]++);if(s&&s.value===respuestasCorrectas[q]){correctas++;cs.forEach(c=>puntajes[c]++)}});
const precision=Math.round(correctas/15*100);document.getElementById("resultNombre").textContent=nombre;document.getElementById("resultCargo").textContent=cargo;document.getElementById("resultPrecision").textContent=precision+"%";document.getElementById("resultTiempo").textContent=formatearTiempo(tiempoUsado);
const lista=["analisis","problemas","detalle","organizacion","decision","adaptabilidad","comprension"],niveles={};lista.forEach(c=>{const p=totales[c]>0?puntajes[c]/totales[c]*100:0,n=obtenerNivel(p);niveles[c]=n;document.getElementById(c+"Nivel").textContent=n;document.getElementById(c+"Texto").textContent=textoCompetencia(n,c)});
const nombres={analisis:"capacidad analítica",problemas:"resolución de problemas",detalle:"atención al detalle",organizacion:"organización y priorización",decision:"toma de decisiones",adaptabilidad:"adaptabilidad",comprension:"comprensión de instrucciones"},fortalezas=lista.filter(c=>niveles[c]==="Alto");let descripcion=fortalezas.length?"El resultado muestra un perfil con fortalezas destacadas en "+fortalezas.map(c=>nombres[c]).join(", ")+". ":"El resultado muestra un perfil equilibrado, con oportunidades de desarrollo en algunas de las competencias evaluadas. ";descripcion+="La evaluación presentó una precisión general de "+precision+"% y un tiempo de respuesta "+obtenerVelocidad(tiempoUsado).toLowerCase()+". ";descripcion+="Estos resultados permiten complementar la evaluación del candidato, pero deben considerarse junto con la experiencia, entrevista, referencias y demás antecedentes del proceso de selección.";document.getElementById("conclusion").textContent=descripcion;document.getElementById("test").style.display="none";document.getElementById("resultado").style.display="block";window.scrollTo({top:0,behavior:"smooth"})}
function formatearTiempo(s){return String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0")}
</script>
</body>
</html>
